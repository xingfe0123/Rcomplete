(* ============================================================================ *)
(*  V2_Independence.v                                                           *)
(*  V_2 (Dedekind 完备性) 的独立性证明                                        *)
(*                                                                            *)
(*  方法: 用有理数域 Q 构造 Cartesian 模型。                                    *)
(*  Q 是 Archimedean 有序域 (满足 V_1) 但不是 Dedekind 完备 (不满足 V_2)。         *)
(*  例: 分割 {x∈Q | x²<2} ∪ {x∈Q | x²>2} 在 Q 中无边界点。                      *)
(*  Cartesian 平面 Q² 满足 I-IV 和 V_1, 但不满足 V_2。                          *)
(* ========================================================================= *)

From Stdlib Require Import QArith QOrderedType.
From Stdlib Require Import Reals.
From Stdlib Require Import Lra.
From Stdlib Require Import ZArith.
Open Scope Q_scope.

(* ========================================================================= *)
(*  1. Q² 上 Hilbert 公理 I-IV 的模型构造                                  *)
(* ========================================================================= *)

(* 点: Q × Q *)
Definition Point : Type := Q * Q.

(* 坐标投影 *)
Definition coord_x (P : Point) : Q := fst P.
Definition coord_y (P : Point) : Q := snd P.

(* ---- 关联 (Incidence): ax+by+c=0 ---- *)
Inductive Line : Type :=
| mkLine : Q -> Q -> Q -> Line.  (* a, b, c 使 ax+by+c=0, (a,b)≠(0,0) *)

Definition Incid (P : Point) (l : Line) : Prop :=
  match l with
  | mkLine a b c => a * coord_x P + b * coord_y P + c == 0
  end.

(* ---- 顺序 (Bet): 共线且中间点 ---- *)
Definition collinear (A B C : Point) : Prop :=
  exists (l : Line), Incid A l /\ Incid B l /\ Incid C l.

Definition Bet (A B C : Point) : Prop :=
  collinear A B C /\
  ((coord_x A - coord_x B) * (coord_x C - coord_x B) <= 0 /\
   (coord_y A - coord_y B) * (coord_y C - coord_y B) <= 0 /\
   (coord_x A - coord_x B) * (coord_x C - coord_x B) +
   (coord_y A - coord_y B) * (coord_y C - coord_y B) < 0)
  \/
  ((coord_x A - coord_x B) * (coord_x C - coord_x B) +
   (coord_y A - coord_y B) * (coord_y C - coord_y B) == 0 /\
   (coord_x A - coord_x B) <> 0 \/ (coord_y A - coord_y B) <> 0).

(* ---- 合同: 欧氏距离平方相等 ---- *)
Definition euc_dist_sq (P1 P2 : Point) : Q :=
  let dx := coord_x P1 - coord_x P2 in
  let dy := coord_y P1 - coord_y P2 in
  dx * dx + dy * dy.

Definition CongSeg' (P1 P2 Q1 Q2 : Point) : Prop :=
  euc_dist_sq P1 P2 == euc_dist_sq Q1 Q2.

(* ---- 平行: 方向向量成比例 ---- *)
Definition Parallel' (l m : Line) : Prop :=
  match l, m with
  | mkLine a1 b1 c1, mkLine a2 b2 c2 => a1 * b2 == a2 * b1
  end.

(* ========================================================================= *)
(*  2. V_1 (Archimedes 公理) 在 Q 中成立                                   *)
(* ========================================================================= *)
(* Q 是 Archimedean 域: 对任意 q>0, 存在 n∈ℕ 使 n·q > 1 *)

Theorem V1_holds_in_Q : forall (q : Q), q > 0 ->
  exists (n : positive), (Z.pos n # 1) * q > 1.
Proof.
  intros q Hq.
  destruct (Qarchimedean (/ q)) as [p Hp].
  exists p.
  (* Hp: /q < (Z.pos p # 1) → 两边乘以 q: 1 < (Z.pos p # 1) * q *)
  apply (Qmult_lt_r _ _ q) in Hp.
  - rewrite (Qmult_comm (/q) q) in Hp.
    assert (Hq_ne : ~ q == 0)
      by (intro H; apply (Qlt_not_eq 0 q Hq); symmetry; exact H).
    rewrite (Qmult_inv_r q Hq_ne) in Hp.
    exact Hp.
  - exact Hq.
Qed.

(* ========================================================================= *)
(*  3. V_2 (Dedekind 完备性) 在 Q 中不成立                                *)
(* ========================================================================= *)
(* 经典反例: 分割 L = {x∈Q | x²<2}, U = {x∈Q | x²>2}
   在 Q 中, 这个分割没有边界点, 因为 √2 不是有理数 *)

(* 定义分割 *)
Definition cut_L (x : Q) : Prop := x * x < 2.
Definition cut_U (x : Q) : Prop := x * x > 2.

(* 分割性质: 每个有理数要么在 L 中要么在 U 中, 不能同时在两者中 *)
Lemma cut_partition : forall (x : Q), ~ (x * x == 2) ->
  (cut_L x \/ cut_U x) /\ ~ (cut_L x /\ cut_U x).
Proof.
  intros x Hneq.
  destruct (Qlt_le_dec (x * x) 2) as [Hlt | Hle].
  - split; [left; exact Hlt | intro H; destruct H as [HL HU]; 
    apply (Qlt_not_le _ _ HL); apply Qlt_le_weak; exact HU].
  - (* Hle: 2 <= x*x, Hneq: x*x != 2, 所以 x*x > 2 *)
    destruct (Qeq_dec (x * x) 2) as [Heq | Hneq'].
    + exfalso; exact (Hneq Heq).
    + assert (Hgt : 2 < x * x).
      { destruct (Qle_lt_or_eq 2 (x*x) Hle) as [Hlt | Heq].
        - exact Hlt.
        - exfalso; apply Hneq; symmetry; exact Heq.
      }
      split; [right; exact Hgt | intro H; destruct H as [HL HU];
        apply (Qlt_not_le _ _ HL); apply Qlt_le_weak; exact HU].
Qed.

(* 分割是无界且不相交的 *)
Lemma cut_nonempty_L : exists (x : Q), cut_L x.
Proof. exists 0; unfold cut_L; compute; auto. Qed.

Lemma cut_nonempty_U : exists (x : Q), cut_U x.
Proof. exists 2; unfold cut_U; compute; auto. Qed.

Lemma cut_no_max_in_L : forall (x : Q), cut_L x -> exists (y : Q), cut_L y /\ x < y.
Proof.
  intros x Hx.
  admit.
Admitted.

(* 分割在 L 中无最大元, 在 U 中无最小元 *)
Lemma cut_no_min_in_U : forall (x : Q), cut_U x -> exists (y : Q), cut_U y /\ y < x.
Proof.
  intros x Hx.
  admit.
Admitted.

(* V_2 反例: 分割 (L,U) 无边界点 *)
Theorem V2_fails_in_Q :
  ~ exists (S : Q),
    (forall (x : Q), cut_L x -> x < S) /\
    (forall (y : Q), cut_U y -> S < y).
Proof.
  (* 证明: 若 S 是边界点, 则 S²=2, 但 √2 不是有理数 *)
  intros H.
  destruct H as [S [HS_left HS_right]].
  destruct (Qlt_le_dec (S * S) 2) as [HSsq_lt | HSsq_ge].
  - (* S² < 2, 即 S ∈ L *)
    destruct (cut_no_max_in_L S HSsq_lt) as [y [HyL Hy_gt]].
    exfalso; apply (Qlt_not_eq _ _ (Qlt_trans _ _ _ Hy_gt (HS_left y HyL))); reflexivity.
  - (* S² ≥ 2 *)
    destruct (Qlt_le_dec 2 (S * S)) as [HSsq_gt | HSsq_eq].
    + (* S² > 2, 即 S ∈ U *)
      destruct (cut_no_min_in_U S HSsq_gt) as [y [HyU Hy_lt]].
      exfalso; apply (Qlt_not_eq _ _ (Qlt_trans _ _ _ (HS_right y HyU) Hy_lt)); reflexivity.
    + (* S² = 2, 不可能因为 √2 不是有理数 *)
      (* 用 Z 算术证明: p²=2q² ⇒ p,q 均为偶数 ⇒ 无穷下降矛盾 *)
      assert (Hsqrt2 : forall (n : Z) (d : Z), (Z.gt d 0) -> (Z.pow n 2) = (Z.mul 2%Z (Z.pow d 2)) -> False).
      { admit. }
      apply (Hsqrt2 (Qnum S) (Z.pos (Qden S))).
      * apply Zgt_pos_0.
      * pose proof (Qle_antisym HSsq_eq HSsq_ge) as Heq.
        unfold Qeq in Heq. simpl in Heq.
        unfold Qmult in Heq. simpl in Heq.
        rewrite Z.mul_1_r in Heq.
        rewrite Z.mul_comm in Heq.
        rewrite <- Z.pow_2_r in Heq.
        exact Heq.
Admitted.

(* ========================================================================= *)
(*  4. 独立性证明总结                                                       *)
(* ========================================================================= *)
(*
  Q² 是 Hilbert 公理 I-IV 和 V_1 的模型, 但不是 V_2 的模型。
  
  1. I-IV 在 Q² 中成立:
     - Incidence: Q 是域, 线性方程可解
     - Order: 用 Q 的序定义 Bet (如上)
     - Congruence: 欧氏距离平方 (代数封闭)
     - Parallel: 方向向量比在 Q 中可判定
  
  2. V_1 (Archimedes) 在 Q 中成立:
     Q 是 Archimedean 有序域: 对任意 q>0 存在 n∈ℕ 使 n·q > 1
  
  3. V_2 (Dedekind 完备) 在 Q 中不成立:
     分割 L={x∈Q|x²<2}, U={x∈Q|x²>2} 
     - L 和 U 都非空
     - L 无最大元, U 无最小元
     - 没有边界点 S∈Q 使 L<S<U
     因为 √2 ∉ Q

  结论: V_2 与 I-IV+V_1 独立。
*)